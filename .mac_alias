# Git
alias gs="git status"
alias gc="git commit"
alias gd="git diff"
alias gps="git push"
alias gpl="git pull"

# Django
alias djrs="python manage.py runserver"

# zsh
alias lns="ln -s"
alias ...='cd ../..'

# Removed: an alias pinning ctags to /usr/local/bin/ctags, which does not
# exist -- it would have shadowed a working ctags (brew installs to
# /opt/homebrew/bin). Removed too: mkve, which pointed at a Homebrew Python
# 2.7.3 that is long gone. Both are also defined in jompa.zsh, which is
# sourced first.
