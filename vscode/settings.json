{
  "workbench.colorTheme": "Dark+",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "vim.hlsearch": true,
  "vim.leader": ",",
  "vim.useCtrlKeys": true,
  "vim.normalModeKeyBindings": [
    {
      "before": ["leader", "w"],
      "commands": ["workbench.action.files.save"]
    },
    {
      "before": ["leader", "n"],
      "commands": ["workbench.action.toggleSidebarVisibility"]
    },
    {
      "before": ["-"],
      "commands": ["/"]
    },
    {
      "before": ["leader", "e"],
      "commands": [
        "go-to-next-error.nextInFiles.warning",
        "editor.action.marker.nextInFiles"
      ]
    }
  ],
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter.notebook.ipynb"
  },
  "editor.tabSize": 4,
  "editor.cursorStyle": "line",
  "editor.insertSpaces": false,
  "editor.lineNumbers": "on",
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
  "editor.wordWrap": "off",
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "snyk.yesWelcomeNotification": false,
  "snyk.advanced.autoScanOpenSourceSecurity": true,
  "snyk.advanced.advancedMode": true,
  "snyk.token": "REMOVED-SEE-GIT-HISTORY-REWRITE",
  "go.toolsManagement.autoUpdate": true,
  "editor.inlineSuggest.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "plaintext": false,
    "markdown": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.formatOnSave": false
  },
  "[terraform]": {
    "editor.formatOnSave": false
  },
  "window.zoomLevel": 1,
  "github.copilot.editor.enableAutoCompletions": true,
  "javascript.updateImportsOnFileMove.enabled": "never",
  "github.copilot.nextEditSuggestions.enabled": true,
  "testing.resultsView.layout": "treeLeft"
}
